<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShotXSetup</AssemblyName>
    <RootNamespace>ShotX.Setup</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\ShotX\Assets\shotx.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <!-- Double-click always elevates. The auto-updater starts it with __COMPAT_LAYER=RunAsInvoker, so silent updates still run without a prompt. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="ShotX.Setup.payload.zip" />
  </ItemGroup>

</Project>
