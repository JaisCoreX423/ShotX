<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\shotx.ico</ApplicationIcon>
    <AssemblyName>ShotX</AssemblyName>
    <RootNamespace>ShotX</RootNamespace>
    <Version>1.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <StartupObject>ShotX.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\shotx.ico" />
    <Resource Include="Assets\shotx-256.png" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same Claude Desktop / Claude Code hookup the installer uses (Settings > Connect Claude). -->
    <Compile Include="..\ShotX.Setup\ClaudeIntegration.cs" Link="Services\ClaudeIntegration.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

</Project>
