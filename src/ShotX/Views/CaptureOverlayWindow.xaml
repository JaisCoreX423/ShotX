<Window x:Class="ShotX.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShotX.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <controls:SelectionOverlayCanvas x:Name="Overlay" />

        <Border x:Name="DimensionBadge" Background="#CC1C1C1E" CornerRadius="6" Padding="7,3"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="DimensionText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
        </Border>

        <Border x:Name="MagnifierBorder" Width="120" Height="120" CornerRadius="60" ClipToBounds="True"
                BorderBrush="White" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <Grid>
                <Image x:Name="MagnifierImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Line X1="60" Y1="0" X2="60" Y2="120" Stroke="#AA0A84FF" StrokeThickness="1" />
                <Line X1="0" Y1="60" X2="120" Y2="60" Stroke="#AA0A84FF" StrokeThickness="1" />
            </Grid>
        </Border>

        <Border x:Name="HintBadge" Background="#CC1C1C1E" CornerRadius="8" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="12.5" FontFamily="Segoe UI" />
        </Border>
    </Grid>
</Window>
