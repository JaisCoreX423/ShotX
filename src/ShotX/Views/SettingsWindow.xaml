<Window x:Class="ShotX.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX - Configuración" Width="460" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1" CenterX="230" CenterY="280" />
    </Window.RenderTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Card}">
            <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" FontWeight="SemiBold" />
            <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="40" Height="40"
                    HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource Brush.TextSecondary}" Click="OnCloseClick"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,14,20,20">

                <TextBlock x:Name="AppearanceHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="LanguageLabel" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                        <StackPanel x:Name="LanguagePanel" Orientation="Horizontal" Margin="0,0,0,14" />
                        <TextBlock x:Name="ThemeLabel" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                        <StackPanel x:Name="ThemePanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CaptureHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,6" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Height="40">
                            <TextBlock x:Name="AutoCopyLabel" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <CheckBox x:Name="AutoCopyCheck" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" />
                        <Grid Height="40">
                            <TextBlock x:Name="AutoOpenEditorLabel" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <CheckBox x:Name="AutoOpenEditorCheck" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" />
                        <Grid Height="40">
                            <TextBlock x:Name="PlaySoundLabel" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <CheckBox x:Name="PlaySoundCheck" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HotkeysHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Height="34">
                            <TextBlock x:Name="HotkeyRegionLabel" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <Button x:Name="RegionHotkeyButton" HorizontalAlignment="Right" Style="{StaticResource GhostPillButtonStyle}"
                                    Padding="10,4" FontSize="12" Click="OnHotkeyButtonClick" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" />
                        <Grid Height="34">
                            <TextBlock x:Name="HotkeyFullScreenLabel" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <Button x:Name="FullScreenHotkeyButton" HorizontalAlignment="Right" Style="{StaticResource GhostPillButtonStyle}"
                                    Padding="10,4" FontSize="12" Click="OnHotkeyButtonClick" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" />
                        <Grid Height="34">
                            <TextBlock x:Name="HotkeyWindowLabel" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <Button x:Name="WindowHotkeyButton" HorizontalAlignment="Right" Style="{StaticResource GhostPillButtonStyle}"
                                    Padding="10,4" FontSize="12" Click="OnHotkeyButtonClick" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHintText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SavingHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="SaveFolderLabel" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveFolderBox" IsReadOnly="True" Padding="6,4" FontSize="12" />
                            <Button x:Name="ChooseFolderButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource GhostPillButtonStyle}" Click="OnBrowseFolderClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StartupHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <Grid Height="30">
                        <TextBlock x:Name="StartWithWindowsLabel" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                        <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <TextBlock x:Name="UpdatesHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Height="30">
                            <TextBlock x:Name="AutoUpdateLabel" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" />
                            <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Button x:Name="InstallUpdateButton" Grid.Column="1" Style="{StaticResource PillButtonStyle}"
                                    Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed" Click="OnInstallUpdateClick" />
                            <Button x:Name="CheckUpdatesButton" Grid.Column="2" Style="{StaticResource GhostPillButtonStyle}"
                                    Padding="12,5" Click="OnCheckUpdatesClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AboutHeader" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/shotx-256.png" Width="40" Height="40" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}">
                                <Run Text="ShotX" />
                                <Run x:Name="VersionRun" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock x:Name="CreditsText" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Button x:Name="RepoLinkButton" Style="{StaticResource GhostPillButtonStyle}"
                                    HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" Background="Transparent"
                                    Foreground="{DynamicResource Brush.Accent}" FontSize="12" Click="OnRepoLinkClick" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
