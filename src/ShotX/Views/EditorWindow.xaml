<Window x:Class="ShotX.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX" Width="1180" Height="760" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1" CenterX="590" CenterY="380" />
    </Window.RenderTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Card}">
            <TextBlock Text="ShotX" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12.5" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnMinimizeClick" FontSize="10" />
                <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnMaximizeClick" FontSize="10" />
                <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnCloseClick" FontSize="10" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- Tool buttons populated in code-behind -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas host -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource Brush.Window}">
            <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <Grid x:Name="CanvasHost" Margin="24">
                    <Border x:Name="CanvasShadow" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="Black" />
                        </Border.Effect>
                        <!-- TextInputBox/CropConfirmPanel live INSIDE CanvasContainer, not as its
                             siblings in CanvasHost: whenever the canvas is narrower than the
                             available space, WPF centers the fixed-size canvas control within this
                             Grid, and anything positioned by raw canvas-space coordinates (Margin =
                             an annotation's Bounds) must share that same centered coordinate frame
                             or it drifts away from the shape it's meant to overlay. -->
                        <Grid x:Name="CanvasContainer">
                            <TextBox x:Name="TextInputBox" Visibility="Collapsed" BorderThickness="2" Padding="6,4"
                                     MinWidth="180" MinHeight="34" Background="White" BorderBrush="#0A84FF"
                                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Segoe UI" FontSize="20"
                                     KeyDown="OnTextInputKeyDown" LostFocus="OnTextInputLostFocus">
                                <TextBox.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="Black" />
                                </TextBox.Effect>
                            </TextBox>

                            <StackPanel x:Name="CropConfirmPanel" Orientation="Horizontal" Visibility="Collapsed"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="ApplyCropButton" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Click="OnApplyCropClick" />
                                <Button x:Name="CancelCropButton" Style="{StaticResource GhostPillButtonStyle}" Click="OnCancelCropClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Layers panel -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock x:Name="LayersTitleText" DockPanel.Dock="Top" Margin="12,12,12,8" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LayersPanel" Margin="8,0,8,8" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Bottom action bar -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyBarButton" Content="Copiar" Style="{StaticResource GhostPillButtonStyle}" Margin="0,0,8,0" Click="OnCopyClick" />
                    <Button x:Name="SaveAsBarButton" Content="Guardar como..." Style="{StaticResource GhostPillButtonStyle}" Margin="0,0,8,0" Click="OnSaveAsClick" />
                    <Button x:Name="SaveButton" Content="Guardar" Style="{StaticResource PillButtonStyle}" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
