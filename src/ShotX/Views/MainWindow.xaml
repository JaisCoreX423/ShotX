<Window x:Class="ShotX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX" Width="560" Height="420" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1" CenterX="280" CenterY="210" />
    </Window.RenderTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Card}">
            <TextBlock Text="ShotX" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnMaximizeClick" />
                <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextSecondary}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,10,28,20" VerticalAlignment="Center">
            <TextBlock x:Name="WhatToDoText" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,16" />

            <UniformGrid Columns="3" Rows="1">
                <Button x:Name="RegionButton" Margin="0,0,8,0" Click="OnRegionClick" Style="{StaticResource GhostPillButtonStyle}" Height="96">
                    <StackPanel>
                        <TextBlock Text="&#x25AD;" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="RegionLabel" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="RegionHotkeyLabel" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="FullScreenButton" Margin="4,0,4,0" Click="OnFullScreenClick" Style="{StaticResource GhostPillButtonStyle}" Height="96">
                    <StackPanel>
                        <TextBlock Text="&#x26F6;" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="FullScreenLabel" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="FullScreenHotkeyLabel" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="WindowButton" Margin="8,0,0,0" Click="OnWindowClick" Style="{StaticResource GhostPillButtonStyle}" Height="96">
                    <StackPanel>
                        <TextBlock Text="&#x25A2;" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="WindowLabel" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="WindowHotkeyLabel" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Rectangle Height="1" Fill="{DynamicResource Brush.Separator}" Margin="0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenImageButton" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource GhostPillButtonStyle}" Click="OnOpenImageClick" />
                <Button x:Name="OpenFolderButton" Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource GhostPillButtonStyle}" Click="OnOpenFolderClick" />
                <Button x:Name="SettingsButton" Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource GhostPillButtonStyle}" Click="OnSettingsClick" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
