<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#1E1E1E</Color>
    <Color x:Key="Color.Card">#2C2C2E</Color>
    <Color x:Key="Color.Toolbar">#262626</Color>
    <Color x:Key="Color.Separator">#3A3A3C</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F7</Color>
    <Color x:Key="Color.TextSecondary">#98989D</Color>
    <Color x:Key="Color.ControlBackground">#3A3A3C</Color>
    <Color x:Key="Color.ControlBorder">#48484A</Color>
    <Color x:Key="Color.HoverOverlay">#1EFFFFFF</Color>
    <Color x:Key="Color.SelectedOverlay">#330A84FF</Color>
    <Color x:Key="Color.Accent">#0A84FF</Color>
    <Color x:Key="Color.Danger">#FF453A</Color>
    <Color x:Key="Color.ScrimDim">#8C000000</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Toolbar" Color="{StaticResource Color.Toolbar}" Opacity="0.92" />
    <SolidColorBrush x:Key="Brush.Separator" Color="{StaticResource Color.Separator}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="{StaticResource Color.ControlBackground}" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="{StaticResource Color.HoverOverlay}" />
    <SolidColorBrush x:Key="Brush.SelectedOverlay" Color="{StaticResource Color.SelectedOverlay}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.ScrimDim" Color="{StaticResource Color.ScrimDim}" />

</ResourceDictionary>
